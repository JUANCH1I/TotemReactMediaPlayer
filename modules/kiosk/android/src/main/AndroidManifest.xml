<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Scanning for networks needs a location permission below Android 13 and
       the nearby devices permission from 13 on. A device owner grants these to
       itself, so nobody has to answer a dialog with a remote control. -->
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
  <uses-permission
    android:name="android.permission.NEARBY_WIFI_DEVICES"
    android:usesPermissionFlags="neverForLocation" />

  <application>
    <receiver
      android:name="expo.modules.kiosk.TotemDeviceAdminReceiver"
      android:permission="android.permission.BIND_DEVICE_ADMIN"
      android:exported="true">
      <meta-data
        android:name="android.app.device_admin"
        android:resource="@xml/totem_device_admin" />
      <intent-filter>
        <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
