# pnpm with React Native / Expo: Metro and the native modules expect a flat
# (hoisted) node_modules. Without this pnpm uses its isolated layout and Metro
# cannot resolve packages.
node-linker=hoisted
# Expo SDK packages declare peers that resolve slightly off each other; the
# npm setup relied on legacy-peer-deps for the same reason.
strict-peer-dependencies=false
auto-install-peers=true
